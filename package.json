{
  "name": "booyah-win",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <21.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/api && npm run build --workspace=apps/staff-portal && npm run build --workspace=apps/user-pwa",
    "build:api": "npm run build --workspace=packages/shared && npm run build --workspace=apps/api",
    "build:frontends": "npm run build --workspace=packages/shared && npm run build --workspace=apps/staff-portal && npm run build --workspace=apps/user-pwa",
    "test": "npm run test --workspace=apps/api",
    "seed:admin": "npm run seed:admin --workspace=apps/api --",
    "seed:settings": "npm run seed:settings --workspace=apps/api --",
    "seed:tiers": "npm run seed:tiers --workspace=apps/api --",
    "seed:leaderboard": "npm run seed:leaderboard --workspace=apps/api --",
    "migrate:dev": "npm run migrate:dev --workspace=apps/api --",
    "migrate:test": "npm run migrate:test --workspace=apps/api --",
    "dev:api": "npm run dev --workspace=apps/api",
    "start:api": "npm run start --workspace=apps/api",
    "check:env": "npm run check:env --workspace=apps/api --",
    "dev:pwa": "npm run dev --workspace=apps/user-pwa",
    "test:pwa": "npm run test --workspace=apps/user-pwa",
    "dev:staff": "npm run dev --workspace=apps/staff-portal",
    "test:staff": "npm run test --workspace=apps/staff-portal",
    "test:all": "npm run test && npm run test:pwa && npm run test:staff",
    "contracts": "npm run contracts --workspace=apps/api",
    "smoke": "tsx scripts/smoke.ts"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "^11.1.0"
    }
  }
}