# Booyah Win User PWA Environment Variables
# API Base URL (if empty or relative, requests go to /api via proxy or current host)
VITE_API_URL=
# API origin for Content Security Policy (connect-src and img-src)
VITE_API_ORIGIN=
# Storage origin for Content Security Policy (e.g. Supabase storage domain)
VITE_STORAGE_ORIGIN=
