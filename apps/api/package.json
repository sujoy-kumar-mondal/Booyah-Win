{
  "name": "@booyah/api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:settings": "tsx src/scripts/seedSettings.ts",
    "seed:tiers": "tsx src/scripts/seedTiers.ts",
    "seed:leaderboard": "tsx src/scripts/seedLeaderboard.ts",
    "migrate:dev": "tsx src/scripts/runDevMigrations.ts",
    "migrate:test": "tsx src/scripts/runTestMigrations.ts",
    "check:env": "tsx src/scripts/checkEnv.ts",
    "contracts": "tsx src/scripts/generateContracts.ts"
  },
  "dependencies": {
    "@booyah/shared": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "node-pg-migrate": "^7.5.2",
    "nodemailer": "^10.1.0",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
